# ---------- GCP ----------
GCP_PROJECT_ID=air-flights-503006
GCP_BUCKET_NAME=rtdp-data-lake2
GCP_LOCATION=US
BIGQUERY_DATASET=raw
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-service-account.json

# dlt filesystem destination (bucket root; each pipeline sets its own dataset_name subpath, e.g. bronze/openaq)
DESTINATION__FILESYSTEM__BUCKET_URL=gs://rtdp-data-lake2

# ---------- OPENSKY ----------
OPENSKY_CLIENT_ID=your_opensky_client_id
OPENSKY_CLIENT_SECRET=your_opensky_client_secret
# One or more "RegionName,lamin,lomin,lamax,lomax" pairs separated by "|" - kept small for a learning/demo footprint
OPENSKY_BBOXES=Switzerland,45.8389,5.9962,47.8229,10.5226

# ---------- OpenAQ ----------
OPENAQ_API_KEY=nol5Stf8OXSzEobu0qesVbw0fyUHiykb
OPENAQ_COUNTRIES=US,PK
OPENAQ_BACKFILL_DAYS=30
OPENAQ_MAX_ROWS_PER_SENSOR=50
OPENAQ_MAX_LOCATIONS_PER_COUNTRY=5

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_OPENSKY=opensky.states.raw

# ---------- Kestra ----------
KESTRA_URL=http://kestra:8080

# ---------- Stream ----------
STREAM_TRIGGER_SECONDS=30
